{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "formatter": { "indentStyle": "space", "indentWidth": 2 },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "asNeeded" }
  },
  "files": {
    "includes": [
      "**",
      "!node_modules",
      "!dist",
      "!.next",
      "!docs-site/node_modules",
      "!docs-site/.next",
      "!docs-site/out",
      "!docs-site/next-env.d.ts",
      "!**/pnpm-lock.yaml",
      "!**/*.tsbuildinfo",
      "!.playwright-cli",
      "!.workbuddy"
    ]
  },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": { "noUnknownAtRules": "off" }
    }
  }
}
